{
  "name": "pi-headed-browser",
  "version": "1.0.0",
  "description": "Pi extension that drives a headed Chromium window (Playwright) with small, composable tools that work well inside codemode. Real-user scrolling, hover dwell, and visible-only reads.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {},
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/01-core-navigation.ts",
    "test:all": "tsx test/01-core-navigation.ts && tsx test/02-interaction.ts && tsx test/03-inspection.ts && tsx test/04-extension.ts",
    "test:smoke": "tsx test/01-core-navigation.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "playwright",
    "browser",
    "automation",
    "headed",
    "chromium",
    "extension",
    "codemode",
    "ai-agent"
  ],
  "author": "Danu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danu28/pi-headed-browser.git"
  },
  "homepage": "https://github.com/Danu28/pi-headed-browser#readme",
  "bugs": {
    "url": "https://github.com/Danu28/pi-headed-browser/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "typebox": "^1.3.36"
  },
  "packageManager": "npm@10",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
